# CLI
# -----------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Public records / public data API and safe scraping tool."
    )

    parser.add_argument(
        "--delay", type=float, default=1.0, help="Delay between HTTP requests."
    )
    parser.add_argument("--jsonl", help="Write results to JSONL.")
    parser.add_argument("--csv", help="Write results to CSV.")
    parser.add_argument("--pretty", action="store_true", help="Pretty-print JSON.")

    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("datagov", help="Search Data.gov CKAN metadata.")
    p.add_argument("query")
    p.add_argument("--rows", type=int, default=10)

    p = sub.add_parser("federal-register", help="Search Federal Register.")
    p.add_argument("query")
    p.add_argument("--per-page", type=int, default=20)

    p = sub.add_parser("courtlistener", help="Search CourtListener opinions.")
    p.add_argument("query")
    p.add_argument("--page-size", type=int, default=20)

    p = sub.add_parser("sec-submissions", help="Get SEC company submissions by CIK.")
    p.add_argument("cik")

    p = sub.add_parser("fec-candidates", help="Search FEC candidates.")
    p.add_argument("query")
    p.add_argument("--per-page", type=int, default=20)

    p = sub.add_parser("nppes", help="Search NPPES/NPI Registry.")
    p.add_argument("--first-name")
    p.add_argument("--last-name")
    p.add_argument("--organization-name")
    p.add_argument("--city")
    p.add_argument("--state")
    p.add_argument("--limit", type=int, default=20)

    p = sub.add_parser("census", help="Generic Census API query.")
    p.add_argument("--dataset", required=True, help="Example: 2022/acs/acs5/profile")
    p.add_argument(
        "--get", required=True, dest="get_fields", help="Example: NAME,DP05_0001E"
    )
    p.add_argument("--for", required=True, dest="for_clause", help="Example: county:*")
    p.add_argument("--in", dest="in_clause", help="Example: state:45")

    p = sub.add_parser("openstates-bills", help="Search OpenStates bills.")
    p.add_argument("query")
    p.add_argument("--jurisdiction")
    p.add_argument("--per-page", type=int, default=20)

    p = sub.add_parser("socrata", help="Query a Socrata dataset.")
    p.add_argument("--domain", required=True, help="Example: data.cityofnewyork.us")
    p.add_argument("--dataset-id", required=True, help="Example: bnx9-e6tj")
    p.add_argument("--select", default="*")
    p.add_argument("--where")
    p.add_argument("--limit", type=int, default=100)
    p.add_argument("--order")

    p = sub.add_parser("socrata-discover", help="Search Socrata catalog.")
    p.add_argument("query")
    p.add_argument("--limit", type=int, default=10)

    p = sub.add_parser("fcc-area", help="FCC Census block lookup by coordinates.")
    p.add_argument("--lat", type=float, required=True)
    p.add_argument("--lon", type=float, required=True)

    p = sub.add_parser("foia-components", help="Fetch FOIA.gov agency components.")

    p = sub.add_parser(
        "scrape", help="Safely scrape one public page if robots.txt allows it."
    )
    p.add_argument("url")
    p.add_argument("--selector", help="Optional CSS selector.")
    p.add_argument("--max-chars", type=int, default=5000)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    client = HTTPClient(delay_seconds=args.delay)
    engine = PublicRecordsEngine(client=client)

    try:
        if args.command == "datagov":
            records = engine.search_datagov(args.query, rows=args.rows)

        elif args.command == "federal-register":
            records = engine.search_federal_register(args.query, per_page=args.per_page)

        elif args.command == "courtlistener":
            records = engine.search_courtlistener(args.query, page_size=args.page_size)

        elif args.command == "sec-submissions":
            records = engine.sec_company_submissions(args.cik)

        elif args.command == "fec-candidates":
            records = engine.search_fec_candidates(args.query, per_page=args.per_page)

        elif args.command == "nppes":
            records = engine.search_nppes(
                first_name=args.first_name,
                last_name=args.last_name,
                organization_name=args.organization_name,
                city=args.city,
                state=args.state,
                limit=args.limit,
            )

        elif args.command == "census":
            records = engine.census_get(
                dataset_path=args.dataset,
                get_fields=args.get_fields,
                for_clause=args.for_clause,
                in_clause=args.in_clause,
            )

        elif args.command == "openstates-bills":
            records = engine.search_openstates_bills(
                args.query, jurisdiction=args.jurisdiction, per_page=args.per_page
            )

        elif args.command == "socrata":
            records = engine.socrata_query(
                domain=args.domain,
                dataset_id=args.dataset_id,
                select=args.select,
                where=args.where,
                limit=args.limit,
                order=args.order,
            )

        elif args.command == "socrata-discover":
            records = engine.socrata_discover(args.query, limit=args.limit)

        elif args.command == "fcc-area":
            records = engine.fcc_area_by_coords(latitude=args.lat, longitude=args.lon)

        elif args.command == "foia-components":
            records = engine.foia_agency_components()

        elif args.command == "scrape":
            records = engine.safe_scrape_page(
                args.url,
                css_selector=args.selector,
                max_chars=args.max_chars,
            )

        else:
            raise RuntimeError(f"Unknown command: {args.command}")

    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1

    # Output routing
    if args.jsonl:
        # Support single-record dicts by wrapping.
        if isinstance(records, dict):
            write_jsonl(args.jsonl, [records])
        else:
            write_jsonl(args.jsonl, records)

    if args.csv:
        # CSV expects list[dict].
        if isinstance(records, dict):
            write_csv(args.csv, [records])
        else:
            write_csv(args.csv, records)

    if not args.jsonl and not args.csv:
        if args.pretty:
            print_json(records)
        else:
            # Compact default
            print(json.dumps(records, ensure_ascii=False))

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
