#!/usr/bin/env bash
set -Eeuo pipefail
# MENU_LABEL=List launchers
# MENU_DESCRIPTION=Show discovered launchers and their availability.
# MENU_RISK=low
CLI="${OFFENSIVECTL_COMMAND:-$(command -v offensivectl || true)}"
[[ -n "$CLI" ]] || { printf 'ERROR: offensivectl was not found in PATH.\n' >&2; exit 127; }
exec "$CLI" launchers
