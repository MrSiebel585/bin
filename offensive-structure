#!/usr/bin/env bash
set -euo pipefail

SOURCE_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE_PATH" ]]; do
  SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE_PATH")" && pwd)"
  SOURCE_PATH="$(readlink -- "$SOURCE_PATH")"
  [[ "$SOURCE_PATH" != /* ]] && SOURCE_PATH="$SOURCE_DIR/$SOURCE_PATH"
done

SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE_PATH")" && pwd)"
readonly SCRIPT_DIR
ROOT_DIR="${OFFENSIVECTL_ROOT:-$(cd "$SCRIPT_DIR/.." && pwd -P)}"
readonly ROOT_DIR
readonly MODULES_DIR="$ROOT_DIR/modules"
readonly REGISTRY_FILE="$ROOT_DIR/registry/modules.tsv"

failures=0
warnings=0

ok() {
  printf '[OK] %s\n' "$*"
}

warn() {
  warnings=$((warnings + 1))
  printf '[WARN] %s\n' "$*"
}

fail() {
  failures=$((failures + 1))
  printf '[FAIL] %s\n' "$*"
}

section() {
  printf '\n[%s]\n' "$1"
}

check_dir() {
  local rel="$1"
  local purpose="$2"

  if [[ -d "$ROOT_DIR/$rel" ]]; then
    ok "$rel - $purpose"
  else
    fail "missing $rel - $purpose"
  fi
}

check_file() {
  local rel="$1"
  local purpose="$2"

  if [[ -f "$ROOT_DIR/$rel" ]]; then
    ok "$rel - $purpose"
  else
    fail "missing $rel - $purpose"
  fi
}

yaml_value() {
  local key="$1"
  local file="$2"

  grep "^${key}:" "$file" 2>/dev/null \
    | head -n 1 \
    | cut -d: -f2- \
    | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' || true
}

check_canonical_dirs() {
  section "Canonical Directories"
  check_dir "bin" "operator commands and stable wrappers"
  check_dir "modules" "runnable category.module implementations"
  check_dir "profiles" "module batches"
  check_dir "registry" "generated module indexes"
  check_dir "docs" "workspace and module documentation"
  check_dir "var/lib/data" "sanitized scoped inputs"
  check_dir "outputs" "generated tool output"
  check_dir "logs" "operator and audit logs"
  check_dir "reports" "case summaries generated by modules"
  check_dir "evidence" "case evidence and hashes"
  check_dir "dashboard" "local Flask dashboard"
  check_file "interfaces/cli/offensivemenuctl/control_plane.py" "local control-plane API"
  check_dir "wireless" "maintained wireless wrappers"
  check_dir "reports/internal/reporting" "template report generator"
}

check_modules() {
  section "Modules"

  if [[ ! -d "$MODULES_DIR" ]]; then
    fail "module root missing: $MODULES_DIR"
    return
  fi

  local count=0
  local category_dir module_dir category module manifest_name manifest_category

  shopt -s nullglob
  for category_dir in "$MODULES_DIR"/*; do
    [[ -d "$category_dir" ]] || continue

    if [[ -L "$category_dir" ]]; then
      warn "skipping symlinked module category: modules/$(basename "$category_dir")"
      continue
    fi

    for module_dir in "$category_dir"/*; do
      [[ -d "$module_dir" ]] || continue

      category="$(basename "$category_dir")"
      module="$(basename "$module_dir")"

      if [[ ! -f "$module_dir/module.yaml" && ! -f "$module_dir/module.sh" ]]; then
        warn "$category.$module is a support directory, not a runnable module"
        continue
      fi

      count=$((count + 1))

      if [[ -f "$module_dir/module.yaml" ]]; then
        ok "$category.$module manifest"
        manifest_name="$(yaml_value name "$module_dir/module.yaml")"
        manifest_category="$(yaml_value category "$module_dir/module.yaml")"

        [[ -z "$manifest_name" || "$manifest_name" == "$module" ]]           || warn "$category.$module manifest name is '$manifest_name'"
        [[ -z "$manifest_category" || "$manifest_category" == "$category" ]]           || warn "$category.$module manifest category is '$manifest_category'"
      else
        fail "$category.$module missing module.yaml"
      fi

      if [[ -f "$module_dir/module.sh" ]]; then
        ok "$category.$module script"
        [[ -x "$module_dir/module.sh" ]] || warn "$category.$module module.sh is not executable"
      else
        fail "$category.$module missing module.sh"
      fi
    done
  done

  if [[ "$count" -eq 0 ]]; then
    warn "no runnable category/module directories found under modules/"
  else
    ok "runnable module directories found: $count"
  fi
}

check_registry() {
  section "Registry"

  if [[ -f "$REGISTRY_FILE" ]]; then
    ok "registry present: registry/modules.tsv"
  else
    warn "registry missing; run ./offensivectl registry rebuild"
  fi
}

check_immutable_fhs() {
  section "Immutable FHS Scaffold"
  check_file "config/immutable-fhs.tsv" "FHS-style hierarchy manifest"
  check_file "bin/offensive-fhs" "hierarchy plan/apply/verify tool"
  check_file "docs/IMMUTABLE_FILESYSTEM_HIERARCHY.md" "hierarchy documentation"
}

check_top_level_hygiene() {
  section "Top-Level Hygiene"

  local backup_files=()
  local legacy_dirs=()

  shopt -s nullglob
  backup_files=("$ROOT_DIR"/*.bak "$ROOT_DIR"/*.bak.* "$ROOT_DIR"/*~)
  legacy_dirs=("$ROOT_DIR/archive" "$ROOT_DIR/backups")

  if [[ "${#backup_files[@]}" -gt 0 ]]; then
    warn "root contains ${#backup_files[@]} backup files; prefer legacy/ or archive/"
  else
    ok "no root backup files found"
  fi

  local dir
  for dir in "${legacy_dirs[@]}"; do
    [[ -d "$dir" ]] && warn "legacy-style directory remains at root: $(basename "$dir")"
  done

  if [[ -f "$ROOT_DIR/Makefile" ]] \
    && grep -q '^OSINT_DIR := osint' "$ROOT_DIR/Makefile" \
    && [[ ! -d "$ROOT_DIR/osint" ]]; then
    warn "Makefile references missing osint/; prefer modules/osint or remove stale targets"
  else
    ok "no stale osint/ Makefile reference detected"
  fi
}

main() {
  echo "Offensive Workspace Structure"
  echo "============================="
  echo "Root: $ROOT_DIR"

  check_canonical_dirs
  check_immutable_fhs
  check_modules
  check_registry
  check_top_level_hygiene

  printf '\nSummary: %s failure(s), %s warning(s)\n' "$failures" "$warnings"
  [[ "$failures" -eq 0 ]]
}

main "$@"
