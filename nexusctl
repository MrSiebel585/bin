#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${NEXUS_ROOT:-/opt/offensive/gui}"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
TOKEN_FILE="$BACKEND/secrets/api-token"
STATE_DIR="${XDG_RUNTIME_DIR:-${HOME}/.cache}/offensivectl-nexus"
BACKEND_PORT=8788
FRONTEND_PORT=5173
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

usage() { printf 'Usage: %s {start|stop|restart|status|check|logs}\n' "$0"; }
port_pid() { ss -H -ltnp "( sport = :$1 )" 2>/dev/null | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2 || true; }
cmdline() { tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null || true; }
ours() {
  local pid="$1" kind="$2" cmd cwd
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  cmd="$(cmdline "$pid")"
  cwd="$(readlink -f "/proc/$pid/cwd" 2>/dev/null || true)"
  if [[ "$kind" == backend ]]; then
    [[ "$cmd" == *uvicorn* && ( "$cwd" == "$BACKEND" || "$cmd" == *"$BACKEND"* ) ]]
  else
    [[ "$cmd" == *vite* && ( "$cwd" == "$FRONTEND" || "$cmd" == *"$FRONTEND"* ) ]]
  fi
}
stop_pid() {
  local pid="$1" kind="$2" i
  if ! ours "$pid" "$kind"; then
    printf '[WARN] Port process %s not identified as NEXUS %s; leaving untouched\n' "$pid" "$kind"
    return 1
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for i in {1..30}; do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.1
  done
  printf '[WARN] PID %s did not exit; not force-killing\n' "$pid"
  return 1
}
stop_service() {
  local kind="$1" port="$2" pid=""
  if [[ -f "$STATE_DIR/$kind.pid" ]]; then
    pid="$(cat "$STATE_DIR/$kind.pid")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && ours "$pid" "$kind"; then
      stop_pid "$pid" "$kind" || true
    fi
    rm -f "$STATE_DIR/$kind.pid"
  fi
  pid="$(port_pid "$port")"
  if [[ -n "$pid" ]]; then stop_pid "$pid" "$kind" || true; fi
}
start_service() {
  local kind="$1" port="$2" dir="$3" pid
  pid="$(port_pid "$port")"
  if [[ -n "$pid" ]]; then
    if ours "$pid" "$kind"; then
      printf '[OK] Existing NEXUS %s listener PID %s; not starting duplicate\n' "$kind" "$pid"
      return 0
    fi
    printf '[ERROR] Port %s occupied by PID %s (not verified NEXUS); refusing startup\n' "$port" "$pid" >&2
    return 1
  fi
  [[ -x "$dir/run.sh" ]] || { printf '[ERROR] Missing %s/run.sh\n' "$dir" >&2; return 1; }
  ( cd "$dir" && exec ./run.sh ) >"$STATE_DIR/$kind.log" 2>&1 &
  printf '%s\n' "$!" > "$STATE_DIR/$kind.pid"
  sleep 1
  pid="$(port_pid "$port")"
  if [[ -z "$pid" ]]; then
    printf '[ERROR] %s did not bind port %s; see %s/%s.log\n' "$kind" "$port" "$STATE_DIR" "$kind" >&2
    return 1
  fi
  printf '[OK] %s listening on 127.0.0.1:%s (PID %s)\n' "$kind" "$port" "$pid"
}
check() {
  local noauth auth
  printf '\n=== HTTP smoke tests ===\n'
  curl -fsS --max-time 5 http://127.0.0.1:8788/health && printf '\n' || true
  noauth="$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:8788/api/jobs || true)"
  auth="$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' -H "X-Control-Token: $(cat "$TOKEN_FILE")" http://127.0.0.1:8788/api/jobs || true)"
  printf 'Jobs without token: HTTP %s (expected 401)\n' "$noauth"
  printf 'Jobs with token:    HTTP %s (expected 200)\n' "$auth"
  printf 'Frontend:           HTTP %s (expected 200)\n' "$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:5173/ || true)"
  [[ "$noauth" == 401 && "$auth" == 200 ]] || return 1
}
case "${1:-}" in
  start|restart)
    [[ -r "$TOKEN_FILE" ]] || { echo '[ERROR] Private token file not readable' >&2; exit 1; }
    export OFFENSIVE_GUI_API_TOKEN="$(<"$TOKEN_FILE")"
    [[ -n "$OFFENSIVE_GUI_API_TOKEN" ]] || { echo '[ERROR] Token file is empty' >&2; exit 1; }
    if [[ "${1}" == restart ]]; then
      stop_service frontend "$FRONTEND_PORT"
      stop_service backend "$BACKEND_PORT"
    fi
    start_service backend "$BACKEND_PORT" "$BACKEND"
    start_service frontend "$FRONTEND_PORT" "$FRONTEND"
    check
    ;;
  stop) stop_service frontend "$FRONTEND_PORT"; stop_service backend "$BACKEND_PORT" ;;
  status)
    for spec in "backend:$BACKEND_PORT" "frontend:$FRONTEND_PORT"; do
      kind="${spec%%:*}"; port="${spec##*:}"; pid="$(port_pid "$port")"
      if [[ -n "$pid" ]]; then printf '%s port %s PID %s\n' "$kind" "$port" "$pid"; else printf '%s port %s stopped\n' "$kind" "$port"; fi
    done
    ;;
  check) [[ -r "$TOKEN_FILE" ]] || exit 1; check ;;
  logs) tail -n 60 "$STATE_DIR/backend.log" "$STATE_DIR/frontend.log" ;;
  *) usage; exit 2 ;;
esac
